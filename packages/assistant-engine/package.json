    "zod": "~4.4.3"
  },
  "devDependencies": {
    "@types/node": "~25.6.0",
    "dotenv": "~17.4.2",
    "eslint": "~10.3.0",
    "typescript": "~6.0.3",
    "vitest": "~4.1.5"
  }
}
